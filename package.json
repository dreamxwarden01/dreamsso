{
  "name": "dreamsso",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx scripts/migrate.ts",
    "test:admin": "node --test admin-ui/src/*.test.js",
    "test:events": "node --import tsx --test tests/roles-sync.test.ts tests/events-http.test.ts tests/event-outbox.test.ts tests/role-authority-http.test.ts tests/settings-cache.test.ts tests/org-proof.test.ts tests/access-state.test.ts tests/client-keys.test.ts tests/admin-return-path.test.ts",
    "test:jwks": "node --import tsx --test tests/public-jwks.test.ts",
    "test:events:db": "node tests/run-role-events-db.mjs",
    "test:keys": "node --import tsx --test tests/account-key-state.test.ts tests/account-client-key-http.test.ts tests/signing-key-cache.test.ts",
    "test:keys:linux": "tsc -p account/server/tsconfig.json && node --test tests/account-key-linux.mjs && npm run test:keys:linux:source",
    "test:keys:linux:source": "ACCOUNT_KEY_SOURCE=1 node --import tsx --test tests/account-key-linux.mjs",
    "test:shutdown": "node --import tsx --test tests/service-lifecycle.test.ts"
  },
  "dependencies": {
    "@peculiar/x509": "^2.0.0",
    "@simplewebauthn/server": "^13.3.2",
    "@types/node-forge": "^1.3.14",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "node-forge": "^1.4.0",
    "otplib": "^13.4.1",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.3",
    "undici": "^8.7.0",
    "uuidv7": "^1.2.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
